NODE_ENV=development
PORT=5005

# MongoDB
MONGO_URI=mongodb://localhost:27017/student_system

# JWT
JWT_SECRET=student_system_jwt_secret_2024_change_in_production
JWT_EXPIRE=7d

# MySQL (for migration scripts)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=student1_db

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM_NAME=Tech Vision Educational Institute
EMAIL_FROM=your_gmail@gmail.com

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Upload paths
UPLOAD_PATH=uploads
MAX_FILE_SIZE=2097152
